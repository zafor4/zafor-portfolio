generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())

  @@map("users")
}

model Profile {
  id               String   @id @default(uuid())
  name             String   @default("Humayra Arzooman")
  title            String   @default("UI/UX Designer & Product Designer")
  location         String   @default("Dhaka, Bangladesh")
  statement        String   @default("[A product-focused Designer & Founder from Bangladesh, building high-performance digital experiences where modern design meets scalable technology, cloud innovation, and intelligent solutions.]")
  availableForWork Boolean  @default(true)
  resumeUrl        String   @default("/resume.pdf")
  avatarUrl        String   @default("/assets/adina.jpeg")
  showHero         Boolean  @default(true)
  showProjects     Boolean  @default(true)
  showExperience   Boolean  @default(true)
  showSkills       Boolean  @default(true)
  showGithub       Boolean  @default(true)
  showContact      Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("profile")
}

model Project {
  id           String   @id @default(uuid())
  title        String
  type         String   @default("website")
  image        String
  description  String
  technologies String[]
  github       String?
  live         String?
  figma        String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("projects")
}

model Experience {
  id        String   @id @default(uuid())
  company   String
  role      String
  duration  String
  desc      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("experiences")
}

model Skill {
  id        String @id @default(uuid())
  name      String
  category  String
  icon      String @default("Code2")
  bg        String @default("bg-foreground/10")
  color     String @default("text-foreground")
  sortOrder Int    @default(0)

  @@map("skills")
}

model Contact {
  id             String   @id @default(uuid())
  location       String   @default("DHAKA, BANGLADESH")
  email          String   @default("adinahawaldar895@gmail.com")
  linkedin       String   @default("https://linkedin.com/in/adina-hawaldar-17az6")
  github         String   @default("https://github.com/adinahawaldar")
  figma          String   @default("https://figma.com/@adinahawaldar")
  twitter        String   @default("https://twitter.com/@adina_hawaldar")
  githubUsername String   @default("adinahawaldar")
  officeImageUrl String   @default("/assets/professional_office.png")
  updatedAt      DateTime @updatedAt

  @@map("contact")
}
